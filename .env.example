# ---------------------------------------------------------------------------
# Engineering OS - environment configuration
# Copy to `.env` and adjust. Never commit the real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL. The single source of truth for every module.
DATABASE_URL="postgresql://engos:engos@localhost:5432/engineering_os?schema=public"

# 32+ char secret used to sign session JWTs. Rotate to invalidate every session.
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 12h - one working shift).
SESSION_TTL_SECONDS=43200

# Public base URL, used in notification deep links.
APP_URL="http://localhost:3000"

# Password used for every seeded demo account. Seeding refuses to run without it.
SEED_PASSWORD="Engos@2026"
