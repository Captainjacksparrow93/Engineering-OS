# ---------------------------------------------------------------------------
# Engineering OS - Hostinger VPS Traefik Environment Configuration
# Copy this file to `.env` on your VPS and adjust values.
# ---------------------------------------------------------------------------

# Domain (Use *.srv1275499.hstgr.cloud wildcard or a custom domain pointing to 72.62.248.38)
DOMAIN="engos.srv1275499.hstgr.cloud"

# Public URL used in notification deep links & session validation
APP_URL="https://engos.srv1275499.hstgr.cloud"

# PostgreSQL Configuration (Private internal database)
POSTGRES_USER="engos"
POSTGRES_PASSWORD="generate-a-strong-db-password-here"
POSTGRES_DB="engineering_os"

# Database connection string used by the app inside Docker
DATABASE_URL="postgresql://engos:generate-a-strong-db-password-here@db:5432/engineering_os?schema=public"

# 32+ char secret used to sign session JWTs. (Generate via: openssl rand -base64 32)
AUTH_SECRET="generate-a-random-32-char-secret-key-here"

# Session lifetime in seconds (default 43200 = 12h / one working shift)
SESSION_TTL_SECONDS=43200

# Password used for seeded demo account (if running initial seed)
SEED_PASSWORD="ChangeMe@2026!"
