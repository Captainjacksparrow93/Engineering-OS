  bins ErpBin[]

  @@unique([companyId, name])
  @@unique([companyId, systemKey])
  @@map("erp_warehouses")
}

model ErpItem {
  id                 String   @id @default(cuid())
  companyId          String
  code               String
  name               String
  description        String?
  itemGroup          String   @default("General")
  uom                String   @default("Nos")
  make               String?
  makerPartNo        String?
  hsnCode            String?
  gstRate            Decimal  @default(18) @db.Decimal(5, 2)
  isStockItem        Boolean  @default(true)
  isPurchaseItem     Boolean  @default(true)
  isSalesItem        Boolean  @default(true)
  /// Selling rate used to prefill sales documents.
  standardRate       Decimal? @db.Decimal(14, 2)
  lastPurchaseRate   Decimal? @db.Decimal(14, 2)
  reorderLevel       Decimal? @db.Decimal(14, 3)
  reorderQty         Decimal? @db.Decimal(14, 3)
