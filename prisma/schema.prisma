  @@unique([companyId, name])
  @@map("erp_workstations")
}

model ErpBom {
  id              String       @id @default(cuid())
  companyId       String
  number          String
  itemId          String
  /// Quantity of the item this BOM makes.
  qty             Decimal      @default(1) @db.Decimal(18, 3)
  status          ErpDocStatus @default(DRAFT)
  isActive        Boolean      @default(true)
  isDefault       Boolean      @default(false)
  projectId       String?
  remarks         String?
  rawMaterialCost Decimal      @default(0) @db.Decimal(18, 2)
  operatingCost   Decimal      @default(0) @db.Decimal(18, 2)
  totalCost       Decimal      @default(0) @db.Decimal(18, 2)
  createdById     String
  submittedById   String?
  submittedAt     DateTime?
  cancelledById   String?
  cancelledAt     DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  items      ErpBomItem[]
  operations ErpBomOperation[]

  @@unique([companyId, number])
  @@index([companyId, itemId, isDefault])
  @@map("erp_boms")
}

model ErpBomItem {
  id         String  @id @default(cuid())
  bomId      String
  itemId     String
  qty        Decimal @db.Decimal(18, 3)
  rate       Decimal @default(0) @db.Decimal(14, 2)
  amount     Decimal @default(0) @db.Decimal(18, 2)
  /// A sub-assembly's own BOM (multi-level).
  childBomId String?
  sortOrder  Int     @default(0)

  bom ErpBom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId, sortOrder])
  @@index([itemId])
  @@map("erp_bom_items")
}

model ErpBomOperation {
  id            String  @id @default(cuid())
  bomId         String
  operation     String
  workstationId String
  /// Minutes for the BOM quantity.
  timeMinutes   Decimal @db.Decimal(12, 2)
  hourRate      Decimal @default(0) @db.Decimal(12, 2)
  cost          Decimal @default(0) @db.Decimal(18, 2)
  sequence      Int     @default(0)

  bom ErpBom @relation(fields: [bomId], references: [id], onDelete: Cascade)

  @@index([bomId, sequence])
  @@map("erp_bom_operations")
}

model ErpWorkOrder {
  id                     String       @id @default(cuid())
  companyId              String
  number                 String
  itemId                 String
  bomId                  String
  qty                    Decimal      @db.Decimal(18, 3)
  producedQty            Decimal      @default(0) @db.Decimal(18, 3)
  /// Finished-good quantity whose materials have reached WIP.
  materialTransferredQty Decimal      @default(0) @db.Decimal(18, 3)
  status                 ErpDocStatus @default(DRAFT)
  isStopped              Boolean      @default(false)
  plannedStart           DateTime?    @db.Date
  expectedEnd            DateTime?    @db.Date
  sourceWarehouseId      String
  wipWarehouseId         String
  fgWarehouseId          String
  salesOrderId           String?
  salesOrderLineId       String?
  productionPlanId       String?
  projectId              String?
  remarks                String?
  createdById            String
  submittedById          String?
  submittedAt            DateTime?
  cancelledById          String?
  cancelledAt            DateTime?
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt

  items ErpWorkOrderItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@index([salesOrderLineId])
  @@index([productionPlanId])
  @@index([companyId, projectId])
  @@map("erp_work_orders")
}

model ErpWorkOrderItem {
  id                String  @id @default(cuid())
  workOrderId       String
  itemId            String
  requiredQty       Decimal @db.Decimal(18, 3)
  transferredQty    Decimal @default(0) @db.Decimal(18, 3)
  consumedQty       Decimal @default(0) @db.Decimal(18, 3)
  sourceWarehouseId String
  sortOrder         Int     @default(0)

  workOrder ErpWorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId, sortOrder])
  @@map("erp_work_order_items")
}

enum ErpJobCardStatus {
  OPEN
  WORK_IN_PROGRESS
  COMPLETED
  CANCELLED
}

model ErpJobCard {
  id             String           @id @default(cuid())
  companyId      String
  number         String
  workOrderId    String
  operation      String
  workstationId  String
  sequence       Int              @default(0)
  forQty         Decimal          @db.Decimal(18, 3)
  completedQty   Decimal          @default(0) @db.Decimal(18, 3)
  plannedMinutes Decimal          @default(0) @db.Decimal(12, 2)
  totalMinutes   Decimal          @default(0) @db.Decimal(12, 2)
  hourRate       Decimal          @default(0) @db.Decimal(12, 2)
  status         ErpJobCardStatus @default(OPEN)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  logs ErpJobCardLog[]

  @@unique([companyId, number])
  @@index([workOrderId, sequence])
  @@index([companyId, status])
  @@map("erp_job_cards")
}

model ErpJobCardLog {
  id           String   @id @default(cuid())
  jobCardId    String
  /// Who did the work (a user).
  employeeId   String
  fromTime     DateTime
  toTime       DateTime
  minutes      Decimal  @db.Decimal(12, 2)
  completedQty Decimal  @default(0) @db.Decimal(18, 3)
  note         String?
  createdAt    DateTime @default(now())

  jobCard ErpJobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId, fromTime])
  @@index([employeeId, fromTime])
  @@map("erp_job_card_logs")
}

model ErpProductionPlan {
  id            String       @id @default(cuid())
  companyId     String
  number        String
  status        ErpDocStatus @default(DRAFT)
  postingDate   DateTime     @db.Date
  warehouseId   String
  remarks       String?
  createdById   String
  submittedById String?
  submittedAt   DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  items ErpProductionPlanItem[]

  @@unique([companyId, number])
  @@index([companyId, status])
  @@map("erp_production_plans")
}

model ErpProductionPlanItem {
  id               String    @id @default(cuid())
  planId           String
  itemId           String
  bomId            String?
  qty              Decimal   @db.Decimal(18, 3)
  plannedStart     DateTime? @db.Date
  salesOrderLineId String?
  sortOrder        Int       @default(0)

  plan ErpProductionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
  @@map("erp_production_plan_items")
}
