/// Current position of one item in one warehouse. Kept in step by the posting engine.
model ErpBin {
  id            String   @id @default(cuid())
  companyId     String
  itemId        String
  warehouseId   String
  actualQty     Decimal  @default(0) @db.Decimal(18, 3)
  valuationRate Decimal  @default(0) @db.Decimal(18, 4)
  stockValue    Decimal  @default(0) @db.Decimal(18, 2)
  /// Promised to submitted sales orders, not yet delivered.
  reservedQty   Decimal  @default(0) @db.Decimal(18, 3)
  /// On submitted purchase orders, not yet received.
  orderedQty    Decimal  @default(0) @db.Decimal(18, 3)
  /// On submitted material requests, not yet ordered.
  requestedQty  Decimal  @default(0) @db.Decimal(18, 3)
  /// To be produced by open work orders.
  plannedQty    Decimal  @default(0) @db.Decimal(18, 3)
  updatedAt     DateTime @updatedAt

  item      ErpItem      @relation(fields: [itemId], references: [id], onDelete: Restrict)
  warehouse ErpWarehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  @@unique([itemId, warehouseId])
  @@index([companyId, warehouseId])
  @@map("erp_bins")
}

/// Every stock movement, in posting order. Moving-average valuation.
model ErpStockLedger {
  id            String   @id @default(cuid())
  companyId     String
  itemId        String
  warehouseId   String
  postingDate   DateTime @db.Date
  qtyChange     Decimal  @db.Decimal(18, 3)
  /// Rate of this movement: the incoming rate, or the valuation rate it left at.
  rate          Decimal  @db.Decimal(18, 4)
  valueChange   Decimal  @db.Decimal(18, 2)
  qtyAfter      Decimal  @db.Decimal(18, 3)
  valuationRate Decimal  @db.Decimal(18, 4)
  stockValue    Decimal  @db.Decimal(18, 2)
  voucherType   String
  voucherId     String
  voucherNo     String
  voucherLineId String?
  projectId     String?
  isCancelled   Boolean  @default(false)
  seq           Int      @default(autoincrement())
  createdAt     DateTime @default(now())

  @@index([itemId, warehouseId, seq])
  @@index([companyId, postingDate])
  @@index([voucherType, voucherId])
  @@index([companyId, projectId])
  @@map("erp_stock_ledger")
}

enum ErpStockPurpose {
  MATERIAL_RECEIPT
  MATERIAL_ISSUE
  MATERIAL_TRANSFER
  TRANSFER_FOR_MANUFACTURE
  MANUFACTURE
}

model ErpStockEntry {
  id                String          @id @default(cuid())
  companyId         String
  number            String
  purpose           ErpStockPurpose
  status            ErpDocStatus    @default(DRAFT)
  postingDate       DateTime        @db.Date
  fromWarehouseId   String?
  toWarehouseId     String?
  projectId         String?
  workOrderId       String?
  materialRequestId String?
  remarks           String?
  totalValue        Decimal         @default(0) @db.Decimal(18, 2)
  /// MANUFACTURE: operating cost added to the finished goods' value.
  additionalCost    Decimal         @default(0) @db.Decimal(18, 2)
  createdById       String
  submittedById     String?
  submittedAt       DateTime?
  cancelledById     String?
  cancelledAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  lines ErpStockEntryLine[]

  @@unique([companyId, number])
  @@index([companyId, status, postingDate])
  @@index([workOrderId])
  @@index([materialRequestId])
  @@map("erp_stock_entries")
}

model ErpStockEntryLine {
  id                    String  @id @default(cuid())
  entryId               String
  itemId                String
  qty                   Decimal @db.Decimal(18, 3)
  fromWarehouseId       String?
  toWarehouseId         String?
  /// Incoming rate for receipts; the valuation rate it left at for issues (set on submit).
  rate                  Decimal @default(0) @db.Decimal(18, 4)
  amount                Decimal @default(0) @db.Decimal(18, 2)
  /// MANUFACTURE: the finished good produced (its rate is the consumed cost).
  isFinishedGood        Boolean @default(false)
  materialRequestLineId String?
  sortOrder             Int     @default(0)

  entry ErpStockEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId, sortOrder])
  @@index([itemId])
  @@map("erp_stock_entry_lines")
}

enum ErpReconPurpose {
  OPENING
  ADJUSTMENT
}

/// Sets the counted quantity and rate of items; the difference posts to Opening Balance
/// Equity (opening stock) or Stock Adjustment.
model ErpStockReconciliation {
  id              String          @id @default(cuid())
  companyId       String
  number          String
  purpose         ErpReconPurpose @default(ADJUSTMENT)
  status          ErpDocStatus    @default(DRAFT)
