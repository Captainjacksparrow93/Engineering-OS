// =====================================================================================
// Engineering OS - Prisma schema
//
// The schema is a MODULAR MONOLITH: one PostgreSQL database, several bounded contexts
// that are kept apart by naming + explicit seams rather than by separate services.
//
//   core_*     Shared kernel. Identity, org structure, RBAC, audit, events.
//              Every future module (HRMS / ERP / Gate Entry / Production) depends on it.
//   pm_*       Project Management module (the module implemented in this release).
//   Future     hrms_*, erp_*, gate_*, prod_* tables land beside these without touching
//              existing ones. Cross-module reads go through service interfaces, never
//              through foreign keys into another module's private tables.
//
// The only entity a module may reference directly from another context is `User`
// (and `Department`), because identity is shared-kernel by definition. Everything else
// crosses module boundaries as a DomainEvent (see `core_domain_events`).
// =====================================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =====================================================================================
// CORE :: Organisation & identity
// =====================================================================================

model Company {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  gstin     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  departments Department[]
  users       User[]
  projects    Project[]
  clients     Client[]

  salesSettings SalesSettings?
  salesItems    SalesItem[]
  salesAccounts SalesAccount[]
  salesDeals    SalesDeal[]
  salesQuotes   SalesQuote[]
  salesHistory  SalesHistoryLine[]

  gateVisits GateVisit[]

  hrDocuments  HrDocument[]
  hrLeaveTypes HrLeaveType[]
  hrHolidays   HrHoliday[]
  hrSettings   HrSettings?
  hrImports    HrAttendanceImport[]

  @@map("core_companies")
}

model Department {
  id        String   @id @default(cuid())
  companyId String
  name      String
  code      String
  /// Departments are a tree: Engineering > Design > Electrical Design, etc.
  parentId  String?
  headId    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  parent   Department?  @relation("DepartmentTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Department[] @relation("DepartmentTree")
  head     User?        @relation("DepartmentHead", fields: [headId], references: [id], onDelete: SetNull)
  members  User[]       @relation("DepartmentMembers")

  @@unique([companyId, code])
  @@index([parentId])
  @@map("core_departments")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  EXITED
}

/// The shared identity record. HRMS will later attach `hrms_employee_profiles` to this
/// row (payroll, attendance, documents) rather than duplicating people.
model User {
  id                 String     @id @default(cuid())
  companyId          String
  employeeCode       String     @unique
  email              String     @unique
  passwordHash       String
  fullName           String
  phone              String?
  designation        String?
  /// Engineering grade drives default task expectations and approval thresholds.
  grade              Grade      @default(JUNIOR_ENGINEER)
  departmentId       String?
  /// Line manager. The reporting chain is walked for approvals and escalation.
  managerId          String?
  status             UserStatus @default(ACTIVE)
  /// Hours this person is contractually available per working day. Capacity planning
  /// uses this until HRMS takes over shift rosters.
  dailyCapacityHours Float      @default(8)
  skills             String[]   @default([])
  avatarColor        String     @default("#2f5fd8")
  lastLoginAt        DateTime?
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt

  company    Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  department Department?  @relation("DepartmentMembers", fields: [departmentId], references: [id], onDelete: SetNull)
  headOf     Department[] @relation("DepartmentHead")
  manager    User?        @relation("ReportingLine", fields: [managerId], references: [id], onDelete: SetNull)
  reports    User[]       @relation("ReportingLine")

  roleAssignments RoleAssignment[]
  sessions        Session[]
  auditLogs       AuditLog[]
  notifications   Notification[]
  leaves          Leave[]

  ownedProjects                Project[]                 @relation("ProjectManager")
  sponsoredProjects            Project[]                 @relation("ProjectSponsor")
  projectMembers               ProjectMember[]
  createdTasks                 Task[]                    @relation("TaskCreatedBy")
  completedTasks               Task[]                    @relation("TaskCompletedBy")
  taskAssignments              TaskAssignment[]
  progressLogs                 TaskProgressLog[]
  handoversFrom                TaskHandover[]            @relation("HandoverFrom")
  handoversTo                  TaskHandover[]            @relation("HandoverTo")
  handoversRequested           TaskHandover[]            @relation("HandoverRequestedBy")
  handoversDecided             TaskHandover[]            @relation("HandoverDecidedBy")
  taskHandoversHeadApproved    TaskHandover[]            @relation("TaskHandoverHeadApprovedBy")
  projectHandoversFrom         ProjectHandover[]         @relation("ProjectHandoverFrom")
  projectHandoversTo           ProjectHandover[]         @relation("ProjectHandoverTo")
  projectHandoversDecided      ProjectHandover[]         @relation("ProjectHandoverDecidedBy")
  projectHandoversHeadApproved ProjectHandover[]         @relation("ProjectHandoverHeadApprovedBy")
  comments                     TaskComment[]
  commissioningAssignments     CommissioningAssignment[]
  commissioningLogs            CommissioningLog[]

  salesDeals          SalesDeal[]     @relation("SalesDealOwner")
  salesActivities     SalesActivity[] @relation("SalesActivityUser")
  salesQuotesCreated  SalesQuote[]    @relation("SalesQuoteCreatedBy")
  salesQuotesApproved SalesQuote[]    @relation("SalesQuoteApprovedBy")

  gateVisitsHosted  GateVisit[] @relation("GateVisitHost")
  gateVisitsCreated GateVisit[] @relation("GateVisitCreatedBy")

  hrProfile          HrEmployeeProfile?
  hrDocuments        HrDocument[]         @relation("HrDocumentEmployee")
  hrDocumentsUploads HrDocument[]         @relation("HrDocumentUploadedBy")
  hrLeaveRequests    HrLeaveRequest[]     @relation("HrLeaveApplicant")
  hrLeaveManagerActs HrLeaveRequest[]     @relation("HrLeaveManagerBy")
  hrLeaveHeadActs    HrLeaveRequest[]     @relation("HrLeaveHeadBy")
  hrLeaveAllocations HrLeaveAllocation[]
  hrAttendance       HrAttendance[]
  hrRegularisations  HrRegularisation[]   @relation("HrRegularisationEmployee")
  hrRegDecisions     HrRegularisation[]   @relation("HrRegularisationDecidedBy")
  hrImportsRun       HrAttendanceImport[]

  @@index([companyId])
  @@index([departmentId])
  @@index([managerId])
  @@map("core_users")
}

model Session {
  id        String    @id @default(cuid())
  userId    String
  tokenId   String    @unique
  userAgent String?
  ip        String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("core_sessions")
}

/// Grades are engineering-org specific and intentionally ordered, low to high.
enum Grade {
  TRAINEE
  JUNIOR_ENGINEER
  ENGINEER
  SENIOR_ENGINEER
  LEAD_ENGINEER
  MANAGER
  HEAD
  DIRECTOR
}

// =====================================================================================
// CORE :: RBAC
//
// Access control is permission-based, not role-name-based, and every grant is SCOPED.
// A "Project Manager" role granted at scope PROJECT:abc gives nothing on project xyz.
// This is what lets one platform serve directors, department heads and engineers
// without branching on job titles anywhere in application code.
// =====================================================================================

model Role {
  id          String   @id @default(cuid())
  key         String   @unique
  name        String
  description String?
  /// System roles ship with the product and cannot be deleted from the admin UI.
  isSystem    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  permissions RolePermission[]
  assignments RoleAssignment[]

  @@map("core_roles")
}

model Permission {
  id          String  @id @default(cuid())
  /// Dotted key: `<module>.<resource>.<action>` e.g. `pm.task.assign`.
  key         String  @unique
  module      String
  description String?

  roles RolePermission[]

  @@index([module])
  @@map("core_permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("core_role_permissions")
}

enum ScopeType {
  /// Applies across the whole company. Directors, platform admins.
  GLOBAL
  /// Applies to a department subtree. Department heads.
  DEPARTMENT
  /// Applies to a single project. Project managers, engineers on that project.
  PROJECT
}

model RoleAssignment {
  id        String    @id @default(cuid())
  userId    String
  roleId    String
  scopeType ScopeType
  /// Null for GLOBAL. Department id or project id otherwise.
  scopeId   String?
  grantedBy String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId, scopeType, scopeId])
  @@index([userId])
  @@index([scopeType, scopeId])
  @@map("core_role_assignments")
}

// =====================================================================================
// CORE :: Platform services (audit, events, notifications, module registry)
// =====================================================================================

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  module     String
  action     String
  entityType String
  entityId   String
  /// Before/after snapshot of the changed fields only.
  diff       Json?
  ip         String?
  createdAt  DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([module, createdAt])
  @@index([actorId])
  @@map("core_audit_logs")
}

enum EventStatus {
  PENDING
  PROCESSED
  FAILED
}

/// Transactional outbox. Modules publish here inside the same transaction as their
/// write, and consumers (today in-process, tomorrow a worker or a queue) pick them up.
/// This is the seam HRMS/ERP/Production will integrate through - e.g. PM publishes
/// `pm.task.completed`, Production consumes it to release a panel to the shop floor.
model DomainEvent {
  id          String      @id @default(cuid())
  /// `<module>.<entity>.<verb>` e.g. `pm.handover.accepted`.
  name        String
  module      String
  entityType  String
  entityId    String
  payload     Json
  actorId     String?
  status      EventStatus @default(PENDING)
  attempts    Int         @default(0)
  lastError   String?
  processedAt DateTime?
  createdAt   DateTime    @default(now())

  @@index([status, createdAt])
  @@index([name])
  @@index([entityType, entityId])
  @@map("core_domain_events")
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  /// Deep link into the app, e.g. /pm/tasks/<id>.
  link      String?
  readAt    DateTime?
  createdAt DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@map("core_notifications")
}

/// Drives the module launcher. Modules that are not `LIVE` render a "Coming soon"
/// banner instead of their routes, so the shell never has to hardcode a module list.
enum ModuleStatus {
  LIVE
  BETA
  COMING_SOON
}

model ModuleRegistryEntry {
  id          String       @id @default(cuid())
  key         String       @unique
  name        String
  description String
  icon        String
  route       String
  status      ModuleStatus @default(COMING_SOON)
  /// Target release note shown on the coming-soon banner.
  plannedFor  String?
  sortOrder   Int          @default(100)
  updatedAt   DateTime     @updatedAt

  @@map("core_module_registry")
}

/// Placeholder owned by PM today, handed to HRMS when that module lands. Capacity
/// planning subtracts approved leave from availability, so the contract exists now.
enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

model Leave {
  id           String      @id @default(cuid())
  userId       String
  startDate    DateTime    @db.Date
  endDate      DateTime    @db.Date
  reason       String?
  status       LeaveStatus @default(APPROVED)
  /// Set once HRMS owns this record, so PM stops treating it as local data.
  sourceModule String      @default("pm")
  createdAt    DateTime    @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, startDate, endDate])
  @@map("core_leaves")
}

// =====================================================================================
// PM :: Clients & Projects
// =====================================================================================

model Client {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  refNumber   String // e.g. ACS-0042 — the client reference number
  erpCustomer String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  projects Project[]

  @@unique([companyId, name])
  @@unique([companyId, refNumber])
  @@unique([companyId, erpCustomer])
  @@map("pm_clients")
}

enum ProjectStatus {
  DRAFT
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  COMMISSIONING
  CLOSED
  CANCELLED
}

enum ProjectKind {
  WORK_ORDER
  SERVICE_CALL
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// A customer order for control panels. Higher management ("sponsor") defines it,
/// a manager runs it, and the WBS below it is where engineers actually work.
model Project {
  id               String          @id @default(cuid())
  companyId        String
  code             String
  kind             ProjectKind     @default(WORK_ORDER)
  workOrderNo      String?         @unique
  erpSalesOrder    String?         @unique
  clientPoNumber   String?
  erpOrderModified String?
  erpOrderAlert    String?
  erpOrderAlertAt  DateTime?
  name             String
  description      String?
  clientId         String?
  clientName       String
  endUserName      String?
  applicationName  String?
  panelType        String?
  panelCount       Int             @default(0)
  /// Checklist packages in this project: PLC, SCADA, HMI (drives the dashboard type cards).
  automationTypes  String[]        @default([])
  status           ProjectStatus   @default(DRAFT)
  priority         ProjectPriority @default(MEDIUM)
  holdReason       String?
  heldAt           DateTime?
  startDate        DateTime?       @db.Date
  targetEndDate    DateTime?       @db.Date
  actualEndDate    DateTime?       @db.Date
  managerId        String
  sponsorId        String?
  departmentId     String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  client  Client? @relation(fields: [clientId], references: [id], onDelete: SetNull)
  manager User    @relation("ProjectManager", fields: [managerId], references: [id])
  sponsor User?   @relation("ProjectSponsor", fields: [sponsorId], references: [id], onDelete: SetNull)

  members                  ProjectMember[]
  tasks                    Task[]
  milestones               Milestone[]
  handovers                ProjectHandover[]
  commissioningAssignments CommissioningAssignment[]
  commissioningLogs        CommissioningLog[]

  @@index([companyId, status])
  @@index([companyId, code])
  @@index([managerId])
  @@index([clientId])
  @@map("pm_projects")
}

/// Membership is what puts a project on someone's radar; the PROJECT-scoped role
/// assignment is what gives them rights on it. Both are created together.
enum ProjectRole {
  MANAGER
  LEAD
  ENGINEER
  REVIEWER
  OBSERVER
}

model ProjectMember {
  id                String      @id @default(cuid())
  projectId         String
  userId            String
  role              ProjectRole @default(ENGINEER)
  /// Share of this person's capacity nominally reserved for the project.
  allocationPercent Int         @default(100)
  addedAt           DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("pm_project_members")
}

model Milestone {
  id        String    @id @default(cuid())
  projectId String
  name      String
  dueDate   DateTime  @db.Date
  reachedAt DateTime?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks   Task[]

  @@index([projectId])
  @@map("pm_milestones")
}

// =====================================================================================
// PM :: Tasks, dependencies, assignment, handover, progress
// =====================================================================================

enum TaskType {
  /// Planned work that belongs to the project WBS.
  PROJECT
  /// Unplanned work that arrives mid-flight and must be slotted into someone's day.
  ADHOC
  /// A container node in the WBS; its progress rolls up from children.
  PHASE
}

enum TaskStatus {
  DRAFT
  /// Cannot start: at least one dependency is unmet.
  BLOCKED
  TODO
  IN_PROGRESS
  /// Work done, waiting on a reviewer.
  IN_REVIEW
  COMPLETED
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

model Task {
  id           String       @id @default(cuid())
  projectId    String
  /// WBS parent. PHASE tasks are the branches, PROJECT/ADHOC tasks the leaves.
  parentId     String?
  milestoneId  String?
  code         String
  title        String
  description  String?
  type         TaskType     @default(PROJECT)
  status       TaskStatus   @default(TODO)
  priority     TaskPriority @default(MEDIUM)
  /// Order item row name plus unit number, e.g. `a1b2c3#2` (on panel PHASE tasks).
  erpOrderItem String?

  estimatedHours  Float @default(8)
  /// ponytail: actual hours are no longer tracked in UI/workflows; column kept for schema compatibility.
  actualHours     Float @default(0)
  /// 0-100. Leaf tasks take it from the latest progress log; PHASE tasks roll it up
  /// from children weighted by estimated hours.
  percentComplete Int   @default(0)

  plannedStart  DateTime? @db.Date
  plannedEnd    DateTime? @db.Date
  actualStart   DateTime?
  actualEnd     DateTime?
  submittedAt   DateTime?
  completedAt   DateTime?
  completedById String?

  /// Skills a candidate assignee should have. Drives the "who can take this" ranking.
  requiredSkills String[] @default([])
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  parent      Task?      @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children    Task[]     @relation("TaskTree")
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)
  createdBy   User       @relation("TaskCreatedBy", fields: [createdById], references: [id])
  completedBy User?      @relation("TaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)

  assignments  TaskAssignment[]
  progressLogs TaskProgressLog[]
  handovers    TaskHandover[]
  comments     TaskComment[]
  /// Edges where this task is the one that must wait.
  dependencies TaskDependency[]  @relation("SuccessorTask")
  /// Edges where this task is what others are waiting on.
  dependents   TaskDependency[]  @relation("PredecessorTask")

  @@unique([projectId, code])
  @@index([projectId, status])
  @@index([parentId])
  @@index([status, plannedEnd])
  @@map("pm_tasks")
}

/// Standard precedence types, so the schedule engine can express real constraints
/// ("wiring cannot finish before the busbar drawing is approved") rather than only
/// naive finish-to-start chains.
enum DependencyType {
  FINISH_TO_START
  START_TO_START
  FINISH_TO_FINISH
  START_TO_FINISH
}

model TaskDependency {
  id            String         @id @default(cuid())
  predecessorId String
  successorId   String
  type          DependencyType @default(FINISH_TO_START)
  /// Working days of lag (positive) or lead (negative) applied to the constraint.
  lagDays       Int            @default(0)
  createdAt     DateTime       @default(now())

  predecessor Task @relation("PredecessorTask", fields: [predecessorId], references: [id], onDelete: Cascade)
  successor   Task @relation("SuccessorTask", fields: [successorId], references: [id], onDelete: Cascade)

  @@unique([predecessorId, successorId])
  @@index([successorId])
  @@map("pm_task_dependencies")
}

enum AssignmentRole {
  /// Accountable for delivery. Exactly one active owner per task.
  OWNER
  /// Helping out, typically after a partial handover.
  COLLABORATOR
  REVIEWER
}

enum AssignmentStatus {
  ACTIVE
  /// Work was passed on; this row is kept for history and for effort accounting.
  HANDED_OVER
  COMPLETED
  RELEASED
}

model TaskAssignment {
  id             String           @id @default(cuid())
  taskId         String
  userId         String
  role           AssignmentRole   @default(OWNER)
  status         AssignmentStatus @default(ACTIVE)
  /// Hours this person is expected to spend. On a partial handover the outgoing
  /// assignment keeps the hours already burned and the incoming one takes the rest.
  allocatedHours Float            @default(0)
  assignedById   String?
  assignedAt     DateTime         @default(now())
  releasedAt     DateTime?

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, status])
  @@index([userId, status])
  @@map("pm_task_assignments")
}

enum HandoverStatus {
  PENDING
  AWAITING_HEAD_APPROVAL
  ACCEPTED
  DECLINED
  WITHDRAWN
  REJECTED
  CANCELLED
}

/// Peer-to-peer handover. An engineer who cannot finish passes the REMAINING work to
/// a peer; the peer accepts (or rejects), and the manager is notified. Nothing is lost:
/// the original assignment stays on record with the hours already spent.
model TaskHandover {
  id               String         @id @default(cuid())
  taskId           String
  fromUserId       String
  toUserId         String
  requestedById    String?
  reason           String
  /// Percent of the task still to do at the moment of handover.
  remainingPercent Int
  remainingHours   Float
  status           HandoverStatus @default(PENDING)
  /// Who accepted/rejected/withdrew.
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  headApprovedById String?
  headApprovedAt   DateTime?
  headDecisionNote String?
  createdAt        DateTime       @default(now())

  task           Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  fromUser       User  @relation("HandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser         User  @relation("HandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)
  requestedBy    User? @relation("HandoverRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  decidedBy      User? @relation("HandoverDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  headApprovedBy User? @relation("TaskHandoverHeadApprovedBy", fields: [headApprovedById], references: [id], onDelete: SetNull)

  @@index([taskId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("pm_task_handovers")
}

model ProjectHandover {
  id               String         @id @default(cuid())
  projectId        String
  fromUserId       String
  toUserId         String
  reason           String?
  status           HandoverStatus @default(PENDING)
  decidedById      String?
  decidedAt        DateTime?
  decisionNote     String?
  headApprovedById String?
  headApprovedAt   DateTime?
  headDecisionNote String?
  createdAt        DateTime       @default(now())

  project        Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  fromUser       User    @relation("ProjectHandoverFrom", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser         User    @relation("ProjectHandoverTo", fields: [toUserId], references: [id], onDelete: Cascade)
  decidedBy      User?   @relation("ProjectHandoverDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  headApprovedBy User?   @relation("ProjectHandoverHeadApprovedBy", fields: [headApprovedById], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@map("pm_project_handovers")
}

/// Append-only progress ledger. Task.percentComplete/actualHours are projections of
/// this table, which means an audit trail comes for free and disputes are resolvable.
model TaskProgressLog {
  id              String   @id @default(cuid())
  taskId          String
  userId          String
  /// Cumulative completion claimed by this punch-in, 0-100.
  percentComplete Int
  /// Hours burned since the previous punch-in.
  hoursSpent      Float    @default(0)
  note            String
  /// Free-text blocker; when set the task surfaces on the manager's risk board.
  blocker         String?
  loggedFor       DateTime @db.Date
  createdAt       DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@index([userId, loggedFor])
  @@map("pm_task_progress_logs")
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  userId    String
  body      String
  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("pm_task_comments")
}

// =====================================================================================
// PM :: Checklist Templates (Automation Standard Packages)
// =====================================================================================

model ChecklistTemplate {
  id          String   @id @default(cuid())
  code        String   @unique // PLC, SCADA, HMI
  name        String
  description String?
  category    String   @default("AUTOMATION")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  items ChecklistTemplateItem[]

  @@map("pm_checklist_templates")
}

model ChecklistTemplateItem {
  id                   String   @id @default(cuid())
  templateId           String
  stepNumber           Int
  code                 String
  title                String
  description          String?
  recommendedSeniority String   @default("JUNIOR") // ASST_MANAGER, SENIOR, JUNIOR, TRAINEE
  /// ponytail: legacy whole-day duration, no longer read; kept so old rows are not lost. Use defaultDurationHours.
  defaultDurationDays  Int      @default(1)
  defaultDurationHours Float    @default(8)
  isSimulationSignoff  Boolean  @default(false)
  dependsOnStep        Int?
  sortOrder            Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  template ChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId, stepNumber])
  @@map("pm_checklist_template_items")
}

// =====================================================================================
// PM :: Site Commissioning
// =====================================================================================

model CommissioningAssignment {
  id           String    @id @default(cuid())
  projectId    String
  userId       String
  assignedById String
  assignedAt   DateTime  @default(now())
  releasedAt   DateTime?

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("pm_commissioning_assignments")
}

model CommissioningLog {
  id           String    @id @default(cuid())
  projectId    String
  userId       String
  loggedFor    DateTime  @db.Date // the day on site - drives "days on site"
  workDone     String
  blocker      String?
  approvedById String?
  approvedAt   DateTime?
  rejectedAt   DateTime?
  decisionNote String?
  createdAt    DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId, loggedFor]) // one log per engineer per project per day
  @@index([projectId, loggedFor])
  @@index([userId, loggedFor])
  @@map("pm_commissioning_logs")
}

// =====================================================================================
// SALES :: deals, quotes, catalogue and pricing (plan 018)
//
// Sales owns its data. It never holds a foreign key into pm_* tables; a won deal
// records the ERPNext sales order name and WO number as plain text.
// =====================================================================================

/// One row per company. Missing row = defaults in `sales/domain/settings.ts`.
model SalesSettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  targetMarginPct   Decimal  @default(20) @db.Decimal(5, 2)
  /// Quotes below this effective margin need a Director's approval.
  minMarginPct      Decimal  @default(12) @db.Decimal(5, 2)
  gstPct            Decimal  @default(18) @db.Decimal(5, 2)
  priceStaleDays    Int      @default(90)
  /// Price sources in priority order, e.g. ["PURCHASE","PRICE_LIST","BOM_COST"].
  pricePriority     String[] @default(["PURCHASE", "PRICE_LIST", "BOM_COST"])
  quoteValidityDays Int      @default(30)
  followUpDays      Int      @default(7)
  terms             String   @default("")
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("sales_settings")
}

model SalesItem {
  id          String   @id @default(cuid())
  companyId   String
  code        String
  name        String
  make        String?
  makerPartNo String?
  category    String?
  uom         String   @default("Nos")
  erpItemCode String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  prices  SalesItemPrice[]

  @@unique([companyId, code])
  @@index([companyId, name])
  @@map("sales_items")
}

enum SalesPriceSource {
  PURCHASE
  PRICE_LIST
  BOM_COST
}

/// Append-only price history. The "latest price" is resolved at read time.
model SalesItemPrice {
  id            String           @id @default(cuid())
  itemId        String
  source        SalesPriceSource
  /// Net cost per unit (for a price list: list price minus discount).
  rate          Decimal          @db.Decimal(14, 2)
  listPrice     Decimal?         @db.Decimal(14, 2)
  discountPct   Decimal?         @db.Decimal(5, 2)
  supplier      String?
  reference     String?
  effectiveDate DateTime         @db.Date
  createdById   String?
  createdAt     DateTime         @default(now())

  item SalesItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, effectiveDate])
  @@map("sales_item_prices")
}

model SalesAccount {
  id               String    @id @default(cuid())
  companyId        String
  name             String
  /// ACS-XXXX once the account is a PM/ERP client.
  clientRef        String?
  city             String?
  industry         String?
  strategic        Boolean   @default(false)
  /// Average days payments arrive after the due date.
  paymentDelayDays Int?
  /// Overrides the first won order date from history for "years with us".
  customerSince    DateTime? @db.Date
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  company  Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  contacts SalesContact[]
  deals    SalesDeal[]
  history  SalesHistoryLine[]

  @@unique([companyId, name])
  @@map("sales_accounts")
}

model SalesContact {
  id          String   @id @default(cuid())
  accountId   String
  name        String
  email       String?
  phone       String?
  designation String?
  createdAt   DateTime @default(now())

  account SalesAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  deals   SalesDeal[]

  @@index([accountId])
  @@map("sales_contacts")
}

enum SalesDealStage {
  LEAD
  QUALIFIED
  QUOTED
  NEGOTIATION
  WON
  LOST
}

model SalesDeal {
  id                String         @id @default(cuid())
  companyId         String
  code              String
  title             String
  accountId         String
  contactId         String?
  ownerId           String
  stage             SalesDealStage @default(LEAD)
  /// Latest quote's value before GST, or the salesperson's estimate before a quote exists.
  value             Decimal?       @db.Decimal(14, 2)
  expectedCloseDate DateTime?      @db.Date
  source            String?
  lostReason        String?
  closedAt          DateTime?
  erpSalesOrder     String?
  woNumber          String?
  notes             String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  company    Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account    SalesAccount    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  contact    SalesContact?   @relation(fields: [contactId], references: [id], onDelete: SetNull)
  owner      User            @relation("SalesDealOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  activities SalesActivity[]
  quotes     SalesQuote[]

  @@unique([companyId, code])
  @@index([companyId, ownerId, stage])
  @@index([accountId])
  @@map("sales_deals")
}

enum SalesActivityType {
  NOTE
  CALL
  MEETING
  EMAIL
  FOLLOW_UP
  STAGE
}

model SalesActivity {
  id        String            @id @default(cuid())
  dealId    String
  userId    String
  type      SalesActivityType
  note      String
  dueAt     DateTime?
  doneAt    DateTime?
  createdAt DateTime          @default(now())

  deal SalesDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)
  user User      @relation("SalesActivityUser", fields: [userId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@index([userId, doneAt, dueAt])
  @@map("sales_activities")
}

enum SalesQuoteStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SENT
  ACCEPTED
  DECLINED
  SUPERSEDED
}

model SalesQuote {
  id            String           @id @default(cuid())
  companyId     String
  dealId        String
  number        String
  revision      Int              @default(1)
  status        SalesQuoteStatus @default(DRAFT)
  discountPct   Decimal          @default(0) @db.Decimal(5, 2)
  freight       Decimal          @default(0) @db.Decimal(14, 2)
  gstPct        Decimal          @db.Decimal(5, 2)
  validUntil    DateTime         @db.Date
  terms         String           @default("")
  showLineItems Boolean          @default(true)
  approvalNote  String?
  approvedById  String?
  approvedAt    DateTime?
  sentAt        DateTime?
  createdById   String
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  company    Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  deal       SalesDeal        @relation(fields: [dealId], references: [id], onDelete: Cascade)
  createdBy  User             @relation("SalesQuoteCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)
  approvedBy User?            @relation("SalesQuoteApprovedBy", fields: [approvedById], references: [id], onDelete: SetNull)
  lines      SalesQuoteLine[]

  @@unique([companyId, number, revision])
  @@index([dealId])
  @@index([companyId, status])
  @@map("sales_quotes")
}

/// A BOM line. Price is derived: cost / (1 - margin).
model SalesQuoteLine {
  id          String            @id @default(cuid())
  quoteId     String
  /// BOM group, e.g. "PLC Panel 1".
  panel       String
  itemId      String?
  itemCode    String?
  description String
  uom         String            @default("Nos")
  qty         Decimal           @db.Decimal(12, 3)
  unitCost    Decimal           @db.Decimal(14, 2)
  costSource  SalesPriceSource?
  costDate    DateTime?         @db.Date
  marginPct   Decimal           @db.Decimal(5, 2)
  sortOrder   Int               @default(0)

  quote SalesQuote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, sortOrder])
  @@map("sales_quote_lines")
}

enum SalesOutcome {
  WON
  LOST
  OPEN
}

enum SalesHistorySource {
  IMPORT
  DEAL
}

/// Past quotes and orders, one row per line. Imported from Excel/Tally CSV or written
/// when a deal closes. The pricing advice reads only this table.
model SalesHistoryLine {
  id          String             @id @default(cuid())
  companyId   String
  source      SalesHistorySource
  batchId     String?
  ref         String
  date        DateTime           @db.Date
  accountId   String?
  accountName String
  outcome     SalesOutcome
  itemCode    String?
  description String?
  qty         Decimal            @db.Decimal(12, 3)
  unitCost    Decimal?           @db.Decimal(14, 2)
  unitPrice   Decimal            @db.Decimal(14, 2)
  createdAt   DateTime           @default(now())

  company Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  account SalesAccount? @relation(fields: [accountId], references: [id], onDelete: SetNull)

  @@index([companyId, accountId])
  @@index([companyId, itemCode])
  @@index([companyId, ref])
  @@map("sales_history_lines")
}

// =============================================================================
// Gate & Visitors (plan 019). People only; material gate entry is out of scope.
// =============================================================================

enum GateVisitStatus {
  EXPECTED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

/// Who put the visit on the list.
enum GateVisitSource {
  /// Scheduled by the front desk.
  DESK
  /// Scheduled by the employee being visited.
  HOST
  /// Arrived without notice; logged and checked in by the front desk.
  WALK_IN
}

enum GateHostReply {
  COMING
  WAIT
  UNAVAILABLE
}

model GateVisit {
  id             String          @id @default(cuid())
  companyId      String
  visitorName    String
  visitorPhone   String
  visitorCompany String?
  purpose        String
  /// The employee being visited.
  hostId         String
  /// When the visitor is expected; a walk-in's arrival time.
  expectedAt     DateTime
  status         GateVisitStatus @default(EXPECTED)
  source         GateVisitSource
  createdById    String
  checkedInAt    DateTime?
  checkedOutAt   DateTime?
  cancelledAt    DateTime?
  hostReply      GateHostReply?
  hostReplyNote  String?
  hostRepliedAt  DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  company   Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  host      User    @relation("GateVisitHost", fields: [hostId], references: [id], onDelete: Restrict)
  createdBy User    @relation("GateVisitCreatedBy", fields: [createdById], references: [id], onDelete: Restrict)

  @@index([companyId, expectedAt])
  @@index([companyId, status])
  @@index([hostId, status])
  @@map("gate_visits")
}

// =====================================================================================
// HRMS (plan 020). `core_users` stays the identity; HR data hangs off it by userId.
// =====================================================================================

enum HrEmploymentType {
  PERMANENT
  PROBATION
  CONTRACT
  INTERN
  CONSULTANT
}

enum HrGender {
  FEMALE
  MALE
  OTHER
}

enum HrMaritalStatus {
  SINGLE
  MARRIED
  OTHER
}

enum HrDocumentCategory {
  OFFER_LETTER
  APPOINTMENT_LETTER
  ID_PROOF
  ADDRESS_PROOF
  EDUCATION
  EXPERIENCE
  BANK
  CONTRACT
  LETTER
  POLICY
  OTHER
}

/// One per employee. Every field is optional so a record can be filled in over time.
model HrEmployeeProfile {
  id     String @id @default(cuid())
  userId String @unique

  // Job (HR edits)
  dateOfJoining    DateTime?         @db.Date
  employmentType   HrEmploymentType?
  probationEndDate DateTime?         @db.Date
  confirmationDate DateTime?         @db.Date
  workLocation     String?
  noticePeriodDays Int?
  /// The employee's number on the biometric machine, if it differs from the employee code.
  biometricId      String?

  // Personal (the employee edits)
  dateOfBirth      DateTime?        @db.Date
  gender           HrGender?
  maritalStatus    HrMaritalStatus?
  bloodGroup       String?
  personalEmail    String?
  currentAddress   String?
  permanentAddress String?

  // Emergency contact (the employee edits)
  emergencyName     String?
  emergencyRelation String?
  emergencyPhone    String?

  // Statutory and bank (HR edits; masked unless `hr.sensitive.read`)
  pan           String?
  aadhaar       String?
  uan           String?
  esicNumber    String?
  bankName      String?
  bankAccountNo String?
  bankIfsc      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([biometricId])
  @@map("hr_employee_profiles")
}

/// A stored file. `userId` null means a company policy everyone can read. Uploading the same
/// category + title again adds a version; the newest has `supersededAt` null.
model HrDocument {
  id                String             @id @default(cuid())
  companyId         String
  userId            String?
  category          HrDocumentCategory
  title             String
  fileName          String
  mimeType          String
  sizeBytes         Int
  content           Bytes
  version           Int                @default(1)
  supersededAt      DateTime?
  /// False hides an employee document from the employee (HR-only notes, for example).
  visibleToEmployee Boolean            @default(true)
  uploadedById      String
  createdAt         DateTime           @default(now())

  company    Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User?   @relation("HrDocumentEmployee", fields: [userId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("HrDocumentUploadedBy", fields: [uploadedById], references: [id], onDelete: Restrict)

  @@index([companyId, userId, category, title])
  @@map("hr_documents")
}

// ------------------------------------------------------------- HRMS phase 2: time

/// Company HR settings: one working shift for everyone (attendance maths).
model HrSettings {
  id                String   @id @default(cuid())
  companyId         String   @unique
  /// Shift start, minutes after midnight IST (570 = 09:30).
  shiftStartMinutes Int      @default(570)
  graceMinutes      Int      @default(15)
  /// Minutes that make a full day / a half day.
  fullDayMinutes    Int      @default(480)
  halfDayMinutes    Int      @default(240)
  updatedAt         DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("hr_settings")
}

model HrLeaveType {
  id           String   @id @default(cuid())
  companyId    String
  code         String
  name         String
  /// Days granted per calendar year; null = no limit (leave without pay).
  annualDays   Decimal? @db.Decimal(5, 1)
  paid         Boolean  @default(true)
  allowHalfDay Boolean  @default(true)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requests    HrLeaveRequest[]
  allocations HrLeaveAllocation[]

  @@unique([companyId, code])
  @@map("hr_leave_types")
}

/// Overrides a leave type's yearly days for one employee (joined mid-year, carried forward, etc.).
model HrLeaveAllocation {
  id          String   @id @default(cuid())
  userId      String
  leaveTypeId String
  year        Int
  days        Decimal  @db.Decimal(5, 1)
  note        String?
  updatedAt   DateTime @updatedAt

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Cascade)

  @@unique([userId, leaveTypeId, year])
  @@map("hr_leave_allocations")
}

enum HrLeaveStatus {
  PENDING_MANAGER
  PENDING_HEAD
  APPROVED
  REJECTED
  CANCELLED
}

model HrLeaveRequest {
  id          String        @id @default(cuid())
  companyId   String
  userId      String
  leaveTypeId String
  startDate   DateTime      @db.Date
  endDate     DateTime      @db.Date
  halfDay     Boolean       @default(false)
  /// Working days (Mon–Sat, holidays excluded); 0.5 for a half day.
  days        Decimal       @db.Decimal(5, 1)
  reason      String
  status      HrLeaveStatus
  managerById String?
  managerAt   DateTime?
  managerNote String?
  headById    String?
  headAt      DateTime?
  headNote    String?
  cancelledAt DateTime?
  /// The `core_leaves` row written on approval, which Project Management reads.
  coreLeaveId String?       @unique
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  user      User        @relation("HrLeaveApplicant", fields: [userId], references: [id], onDelete: Cascade)
  leaveType HrLeaveType @relation(fields: [leaveTypeId], references: [id], onDelete: Restrict)
  managerBy User?       @relation("HrLeaveManagerBy", fields: [managerById], references: [id], onDelete: SetNull)
  headBy    User?       @relation("HrLeaveHeadBy", fields: [headById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([userId, startDate])
  @@map("hr_leave_requests")
}

model HrHoliday {
  id        String   @id @default(cuid())
  companyId String
  date      DateTime @db.Date
  name      String
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, date])
  @@map("hr_holidays")
}

enum HrAttendanceSource {
  IMPORT
  REGULARISED
}

/// One row per employee per day: first punch in and last punch out.
model HrAttendance {
  id        String             @id @default(cuid())
  userId    String
  date      DateTime           @db.Date
  firstIn   DateTime?
  lastOut   DateTime?
  source    HrAttendanceSource @default(IMPORT)
  importId  String?
  updatedAt DateTime           @updatedAt

  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  importedBy HrAttendanceImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@unique([userId, date])
  @@index([date])
  @@map("hr_attendance")
}

model HrAttendanceImport {
  id           String    @id @default(cuid())
  companyId    String
  fileName     String
  rows         Int
  days         Int
  skipped      Int
  /// Up to 50 skipped-row messages, for HR to fix the file.
  problems     String[]  @default([])
  fromDate     DateTime? @db.Date
  toDate       DateTime? @db.Date
  importedById String
  createdAt    DateTime  @default(now())

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  importedBy User           @relation(fields: [importedById], references: [id], onDelete: Restrict)
  attendance HrAttendance[]

  @@index([companyId, createdAt])
  @@map("hr_attendance_imports")
}

enum HrRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

/// An employee asks to correct a day's punches (forgot to punch, machine down, site visit).
model HrRegularisation {
  id          String          @id @default(cuid())
  userId      String
  date        DateTime        @db.Date
  firstIn     DateTime
  lastOut     DateTime
  reason      String
  status      HrRequestStatus @default(PENDING)
  decidedById String?
  decidedAt   DateTime?
  note        String?
  createdAt   DateTime        @default(now())

  user      User  @relation("HrRegularisationEmployee", fields: [userId], references: [id], onDelete: Cascade)
  decidedBy User? @relation("HrRegularisationDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)

  @@index([userId, date])
  @@index([status])
  @@map("hr_regularisations")
}

// =============================================================================
// ERP (plan 022). Native ERP, ERPNext as the functional benchmark.
//
// Every table carries companyId. People and PM projects are referenced by plain id
// (resolved at read time) so the ERP never adds back-relations to core or PM models.
// Stock and GL tables are written only by `src/modules/erp/services/posting.ts`.
// =============================================================================

/// ERPNext docstatus: 0 draft, 1 submitted, 2 cancelled.
enum ErpDocStatus {
  DRAFT
  SUBMITTED
  CANCELLED
}

enum ErpRootType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
}

/// One row per company. Created with the chart of accounts on first ERP use.
model ErpSettings {
  id                      String    @id @default(cuid())
  companyId               String    @unique
  /// Company's state for GST: same state as the party → CGST + SGST, else IGST.
  companyState            String?
  defaultGstRate          Decimal   @default(18) @db.Decimal(5, 2)
  allowNegativeStock      Boolean   @default(false)
  /// Nothing may be posted on or before this date (period closing).
  booksClosedUpTo         DateTime? @db.Date
  /// On: a work-order project must start from a submitted sales order (plan 014 rule).
  projectsFromSalesOrders Boolean   @default(false)
  /// Printed at the foot of sales orders and invoices.
  salesTerms              String    @default("")
  updatedAt               DateTime  @updatedAt

  @@map("erp_settings")
}

/// Naming series counters, e.g. MAT-STE-2026- → 00042.
model ErpSeries {
  companyId String
  prefix    String
  current   Int    @default(0)

  @@id([companyId, prefix])
  @@map("erp_series")
}

model ErpAccount {
  id          String      @id @default(cuid())
  companyId   String
  code        String
  name        String
  rootType    ErpRootType
  parentId    String?
  isGroup     Boolean     @default(false)
  /// Fixed role the posting engine looks up, e.g. STOCK_IN_HAND, DEBTORS, OUTPUT_CGST.
  systemKey   String?
  /// BANK and CASH accounts are payment accounts.
  accountType String?
  isActive    Boolean     @default(true)
  createdAt   DateTime    @default(now())

  parent   ErpAccount?  @relation("ErpAccountTree", fields: [parentId], references: [id], onDelete: Restrict)
  children ErpAccount[] @relation("ErpAccountTree")
  entries  ErpGlEntry[]

  @@unique([companyId, code])
  @@unique([companyId, systemKey])
  @@index([companyId, parentId])
  @@map("erp_accounts")
}

enum ErpPartyType {
  CUSTOMER
  SUPPLIER
}

/// The general ledger. Every voucher's rows balance; cancelling adds reversing rows and
/// flags both sides `isCancelled` (reports skip them), as ERPNext does.
model ErpGlEntry {
  id          String        @id @default(cuid())
  companyId   String
  postingDate DateTime      @db.Date
  accountId   String
  debit       Decimal       @default(0) @db.Decimal(18, 2)
  credit      Decimal       @default(0) @db.Decimal(18, 2)
  partyType   ErpPartyType?
  partyId     String?
  projectId   String?
  voucherType String
  voucherId   String
  voucherNo   String
  /// The invoice this row settles (payments, credit notes); the voucher itself otherwise.
  againstType String?
  againstId   String?
  remarks     String?
  isCancelled Boolean       @default(false)
  createdAt   DateTime      @default(now())

  account ErpAccount @relation(fields: [accountId], references: [id], onDelete: Restrict)

  @@index([companyId, postingDate])
  @@index([accountId, postingDate])
  @@index([voucherType, voucherId])
  @@index([companyId, partyType, partyId])
  @@index([againstType, againstId])
  @@index([companyId, projectId])
